# --- Nhà cung cấp AI: điền MỘT key ---
# OpenRouter (có model miễn phí): tạo key tại https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Model dự phòng, cách nhau bằng dấu phẩy (tuỳ chọn)
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free
# Gemini (có gói miễn phí): lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Claude (trả phí):
ANTHROPIC_API_KEY=
MARKET_AGENTS_MODEL=claude-opus-5-5
# Bỏ trống = tự chọn theo key có sẵn: claude > groq > openrouter > gemini
MARKET_AGENTS_PROVIDER=

# --- Múi giờ ---
MARKET_AGENTS_TIMEZONE=Asia/Ho_Chi_Minh

# --- Kênh gửi báo cáo (bật kênh nào thì điền kênh đó) ---
# Telegram: tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP). Với Gmail: dùng App Password, host smtp.gmail.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
