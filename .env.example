# --- Nhà cung cấp AI: điền MỘT key ---
# Groq (miễn phí, rất nhanh): tạo key tại https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# Gemini (có gói miễn phí): lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Claude (trả phí):
ANTHROPIC_API_KEY=
MARKET_AGENTS_MODEL=claude-opus-5-5
# Bỏ trống = tự chọn theo key có sẵn: claude > groq > gemini
MARKET_AGENTS_PROVIDER=

# --- Múi giờ ---
MARKET_AGENTS_TIMEZONE=Asia/Ho_Chi_Minh

# --- Kênh gửi báo cáo (bật kênh nào thì điền kênh đó) ---
# Telegram: tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP). Với Gmail: dùng App Password, host smtp.gmail.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
